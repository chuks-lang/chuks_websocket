// Tests for chuks_websocket — pure-Chuks RFC 6455 implementation.
// Run: chuks test tests/index.test.chuks

import { test } from "std/test"
import { time } from "std/time"
import { TcpServer, TcpConnection, tlsSelfSigned } from "std/net"
import { Buffer } from "std/buffer"
import { Deflater, Inflater } from "std/compress"
import { strings } from "std/strings"
import {
    computeAcceptKey,
    WSServerOptionsBuilder,
    WSClientOptionsBuilder,
    WSDeflateOptionsBuilder,
    WebSocketServer,
    WebSocketConnection,
    WebSocketClient,
    WSDeflateOptions,
    connect,
    createWSServer,
    createWSClient,
    isValidUtf8,
    STATE_OPEN,
    CLOSE_NORMAL,
    CLOSE_TOO_LARGE,
    CLOSE_PROTOCOL_ERROR,
    CLOSE_INVALID_PAYLOAD
} from "../src/index.chuks"

// A port the OS has just reported free (bound to port 0, read back, then
// released), so test files running at the same time never pick the same one.
function freePort(): int {
    const probe = new TcpServer("127.0.0.1", 0)
    const parts = probe.addr().split(":")
    probe.close()
    return int(parts[parts.length - 1])
}

var passed: int = 0
var failed: int = 0
var failures: []string = []
const start = test.now()

// Thread-safe collector: the client's onMessage fires on its read-loop task
// (a separate OS thread under AOT), so the main test thread must read what it
// collected through a lock to get a memory barrier — otherwise it races on a
// plain slice header and reads stale length.
@threadSafe
class Collector {
    var items: []string
    constructor() { this.items = [] }
    public add(s: string): void { lock (this) { this.items.push(s) } }
    public count(): int { var n: int = 0; lock (this) { n = this.items.length } return n }
    public first(): string { var s: string = ""; lock (this) { if (this.items.length > 0) { s = this.items[0] } } return s }
}


// Collects binary messages, text messages and the order they came in.
@threadSafe
class BinCollector {
    var bins: []Buffer
    var texts: []string
    var order: []string
    var closeCode: int
    constructor() { this.bins = []; this.texts = []; this.order = []; this.closeCode = 0 }
    public addBin(b: Buffer): void { lock (this) { this.bins.push(b); this.order.push("b:" + string(b.length())) } }
    public addText(s: string): void { lock (this) { this.texts.push(s); this.order.push("t:" + s) } }
    public setClose(code: int): void { lock (this) { this.closeCode = code } }
    public binCount(): int { var n: int = 0; lock (this) { n = this.bins.length } return n }
    public textCount(): int { var n: int = 0; lock (this) { n = this.texts.length } return n }
    public bin(i: int): Buffer { var b: Buffer = Buffer.alloc(0); lock (this) { b = this.bins[i] } return b }
    public text(i: int): string { var t: string = ""; lock (this) { t = this.texts[i] } return t }
    public orderLog(): string { var s: string = ""; lock (this) { s = strings.join(this.order, ",") } return s }
    public code(): int { var c: int = 0; lock (this) { c = this.closeCode } return c }
}

// Poll until cond() holds or ms pass; returns whether it held.
function waitFor(cond: function(): bool, ms: int): bool {
    var waited: int = 0
    while (waited < ms) {
        if (cond()) { return true }
        time.sleep(10)
        waited = waited + 10
    }
    return cond()
}

// A buffer of n bytes where byte i is (i * 7 + seed) % 256.
function pattern(n: int, seed: int): Buffer {
    var b: Buffer = Buffer.alloc(n)
    for (var i: int = 0; i < n; i++) { b.setByte(i, (i * 7 + seed) % 256) }
    return b
}

// A server on a free port whose connections echo text as text and binary as binary.
function echoServer(port: int, maxSize: int): WebSocketServer {
    var server: WebSocketServer = createWSServer(new WSServerOptionsBuilder().host("127.0.0.1").port(port).maxMessageSize(maxSize).build())
    server.onConnection(function(conn: WebSocketConnection): void {
        conn.onMessage(function(msg: string): void { conn.send(msg) })
        conn.onBinary(function(data: Buffer): void { conn.sendBinary(data) })
    })
    spawn server.listen()
    time.sleep(200)
    return server
}

// Connect a client that records everything it receives.
function recordingClient(port: int, into: BinCollector): WebSocketClient {
    var c: WebSocketClient = connect("ws://127.0.0.1:" + string(port), null)
    c.onMessage(function(msg: string): void { into.addText(msg) })
    c.onBinary(function(data: Buffer): void { into.addBin(data) })
    c.onClose(function(code: int, _reason: string): void { into.setClose(code) })
    return c
}

// ── Raw RFC 6455 peers, written here from the spec, independent of the package ──

class RawFrame {
    var fin: bool
    var opcode: int
    var masked: bool
    var payload: Buffer
    var rsv1: bool
    constructor(fin: bool, opcode: int, masked: bool, payload: Buffer) {
        this.fin = fin; this.opcode = opcode; this.masked = masked; this.payload = payload; this.rsv1 = false
    }
}

function readHead(tcp: TcpConnection): string {
    var acc: string = ""
    while (!strings.endsWith(acc, "\r\n\r\n")) { acc = acc + tcp.readExact(1).toStringUtf8() }
    return acc
}

function rawClient(port: int): TcpConnection {
    return rawClientExt(port, "", new Box())
}

@threadSafe
class Box {
    var v: string
    constructor() { this.v = "" }
    public set(s: string): void { lock (this) { this.v = s } }
    public get(): string { var s: string = ""; lock (this) { s = this.v } return s }
}

// A raw client that may offer extensions; the response head goes in `head`.
function rawClientExt(port: int, extensions: string, head: Box): TcpConnection {
    var tcp: TcpConnection = new TcpConnection("127.0.0.1", port, 2000)
    var req: string = "GET / HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n"
    if (extensions != "") { req = req + "Sec-WebSocket-Extensions: " + extensions + "\r\n" }
    tcp.writeAll(Buffer.fromString(req + "\r\n"))
    head.set(readHead(tcp))
    tcp.setReadDeadline(3000)
    return tcp
}

// Compress one message as RFC 7692 says, with a fresh compressor.
function deflateMessage(payload: Buffer): Buffer {
    var d: Deflater = new Deflater(6, 15)
    var head: Buffer = d.write(payload)
    var whole: Buffer = Buffer.concat([head, d.flush()])
    return whole.slice(0, whole.length() - 4)
}

function inflateMessage(payload: Buffer): Buffer {
    var inf: Inflater = new Inflater(15)
    inf.write(payload)
    inf.write(Buffer.fromHex("0000ffff"))
    return inf.read(16777216)
}

// Repetitive JSON-like text, as a game snapshot is.
function snapshotText(n: int, seed: int): string {
    var parts: []string = []
    for (var i: int = 0; i < n; i++) {
        parts.push("{\"id\":" + string(i + seed) + ",\"x\":" + string((i * 37 + seed) % 1000) + ",\"y\":" + string((i * 91) % 1000) + ",\"kind\":\"danfo\",\"speed\":12}")
    }
    return "[" + strings.join(parts, ",") + "]"
}

// A deflate echo server on `port` with these options.
function deflateServer(port: int, maxSize: int, opts: WSDeflateOptions): WebSocketServer {
    var server: WebSocketServer = createWSServer(new WSServerOptionsBuilder().host("127.0.0.1").port(port).maxMessageSize(maxSize).build()).perMessageDeflate(opts)
    server.onConnection(function(conn: WebSocketConnection): void {
        conn.onMessage(function(msg: string): void { conn.send(msg) })
        conn.onBinary(function(data: Buffer): void { conn.sendBinary(data) })
    })
    spawn server.listen()
    time.sleep(200)
    return server
}

// Encode one masked frame (client to server) with the fixed key 1,2,3,4.
function rawFrame(fin: bool, opcode: int, payload: Buffer): Buffer {
    var n: int = payload.length()
    var ext: int = 0
    if (n >= 126 && n <= 65535) { ext = 2 } else if (n > 65535) { ext = 8 }
    var out: Buffer = Buffer.alloc(2 + ext + 4 + n)
    out.writeUInt8((fin ? 128 : 0) + opcode)
    if (ext == 0) { out.writeUInt8(128 + n) } else if (ext == 2) { out.writeUInt8(128 + 126); out.writeUInt16BE(n) } else { out.writeUInt8(128 + 127); out.writeInt64BE(n) }
    for (var k: int = 1; k <= 4; k++) { out.writeUInt8(k) }
    for (var i: int = 0; i < n; i++) { out.writeUInt8(payload.getByte(i) ^ ((i % 4) + 1)) }
    return out
}

function readRawFrame(tcp: TcpConnection): RawFrame {
    var h: Buffer = tcp.readExact(2)
    var b0: int = h.getByte(0)
    var b1: int = h.getByte(1)
    var n: int = b1 & 127
    if (n == 126) { var e2: Buffer = tcp.readExact(2); e2.seek(0); n = e2.readUInt16BE() }
    else if (n == 127) { var e8: Buffer = tcp.readExact(8); e8.seek(0); n = e8.readInt64BE() }
    var masked: bool = (b1 & 128) != 0
    var key: Buffer = Buffer.alloc(4)
    if (masked) { key = tcp.readExact(4) }
    var p: Buffer = Buffer.alloc(0)
    if (n > 0) { p = tcp.readExact(n) }
    if (masked) {
        for (var i: int = 0; i < n; i++) { p.setByte(i, p.getByte(i) ^ key.getByte(i % 4)) }
    }
    var rf: RawFrame = new RawFrame((b0 & 128) != 0, b0 & 15, masked, p)
    rf.rsv1 = (b0 & 64) != 0
    return rf
}

// Send a raw HTTP request and return the response head.
function rawHandshake(port: int, request: string): string {
    var tcp: TcpConnection = new TcpConnection("127.0.0.1", port, 2000)
    tcp.setReadDeadline(3000)
    tcp.writeAll(Buffer.fromString(request))
    var head: string = readHead(tcp)
    tcp.close()
    return head
}

function upgradeRequest(extra: string): string {
    return "GET / HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n" + extra + "\r\n"
}

// The close code in a close frame's payload.
function closeCodeOf(f: RawFrame): int {
    if (f.payload.length() < 2) { return 0 }
    f.payload.seek(0)
    return f.payload.readUInt16BE()
}

// ─── 1. Handshake accept-key (RFC 6455 §1.3 canonical vector) ───────────────
// key "dGhlIHNhbXBsZSBub25jZQ==" must produce "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=".
try {
    var accept: string = computeAcceptKey("dGhlIHNhbXBsZSBub25jZQ==")
    test.assertEqual(accept, "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", "RFC 6455 accept-key vector")
    passed++
} catch (e) {
    failed++
    failures.push("accept-key vector: " + string(e))
}

// ─── 2. Server options builder: defaults + fluent overrides ─────────────────
try {
    var defs = new WSServerOptionsBuilder().build()
    test.assertEqual(defs.host, "0.0.0.0", "default server host")
    test.assertEqual(defs.port, 8080, "default server port")
    test.assertEqual(defs.maxMessageSize, 1048576, "default max message size")

    var opts = new WSServerOptionsBuilder().host("127.0.0.1").port(9001).path("/ws").maxMessageSize(2048).build()
    test.assertEqual(opts.host, "127.0.0.1", "fluent host")
    test.assertEqual(opts.port, 9001, "fluent port")
    test.assertEqual(opts.path, "/ws", "fluent path")
    test.assertEqual(opts.maxMessageSize, 2048, "fluent max size")
    passed++
} catch (e) {
    failed++
    failures.push("server options builder: " + string(e))
}

// ─── 3. Client options builder: defaults + fluent overrides ─────────────────
try {
    var cdef = new WSClientOptionsBuilder().build()
    test.assertEqual(cdef.handshakeTimeoutMs, 10000, "default handshake timeout")
    test.assertEqual(cdef.autoReconnect, false, "default autoReconnect")

    var copts = new WSClientOptionsBuilder().autoReconnect(true).reconnectDelayMs(250).maxReconnectTries(3).build()
    test.assertEqual(copts.autoReconnect, true, "fluent autoReconnect")
    test.assertEqual(copts.reconnectDelayMs, 250, "fluent reconnect delay")
    test.assertEqual(copts.maxReconnectTries, 3, "fluent max reconnect tries")
    passed++
} catch (e) {
    failed++
    failures.push("client options builder: " + string(e))
}

// ─── 4. End-to-end echo over a loopback socket ──────────────────────────────
// Boots a real server, connects a real client, and round-trips a message
// through the full handshake + frame codec + read pump.
try {
    var port: int = freePort()
    var server: WebSocketServer = createWSServer(new WSServerOptionsBuilder().host("127.0.0.1").port(port).build())
    server.onConnection(function(conn: WebSocketConnection): void {
        conn.onMessage(function(msg: string): void {
            conn.send("echo:" + msg)
        })
    })
    spawn server.listen()
    time.sleep(300)   // let the listener bind

    var received: Collector = new Collector()
    var client = connect("ws://127.0.0.1:" + string(port), null)
    client.onMessage(function(msg: string): void {
        received.add(msg)
    })

    test.assert(client.readyState() == STATE_OPEN, "client should be OPEN after connect")

    client.send("hello")
    time.sleep(500)   // allow the round trip

    test.assertEqual(received.count(), 1, "client should receive exactly one echo")
    if (received.count() > 0) {
        test.assertEqual(received.first(), "echo:hello", "echoed payload should match")
    }
    test.assert(server.connectionCount() == 1, "server should report one live connection")

    client.close(CLOSE_NORMAL, "done")
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("echo round-trip: " + string(e))
}

// ─── 5. readTimeoutMs closes a silent client, not a talking one ─────────────
// The server option sets a deadline for each frame: a client that sends nothing
// for longer is closed, and one that keeps sending stays connected.
try {
    var port: int = freePort()
    var server: WebSocketServer = createWSServer(new WSServerOptionsBuilder().host("127.0.0.1").port(port).readTimeoutMs(300).build())
    spawn server.listen()
    time.sleep(300)   // let the listener bind

    var talker = connect("ws://127.0.0.1:" + string(port), null)
    var silent = connect("ws://127.0.0.1:" + string(port), null)
    time.sleep(100)
    test.assertEqual(server.connectionCount(), 2, "both clients connected")
    for (var i: int = 0; i < 12; i++) {
        talker.send("tick")
        time.sleep(100)
    }
    test.assertEqual(server.connectionCount(), 1, "the silent client was closed, the talking one kept")

    talker.close(CLOSE_NORMAL, "done")
    silent.close(CLOSE_NORMAL, "done")
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("read timeout: " + string(e))
}


// ─── 6. Binary: every byte value 0..255 round trips as bytes, not text ──────
try {
    var port: int = freePort()
    var server: WebSocketServer = echoServer(port, 1048576)
    var got: BinCollector = new BinCollector()
    var client: WebSocketClient = recordingClient(port, got)
    var all: Buffer = Buffer.alloc(256)
    for (var i: int = 0; i < 256; i++) { all.setByte(i, i) }
    client.sendBinary(all)
    test.assert(waitFor(function(): bool { return got.binCount() == 1 }, 3000), "binary echo arrived")
    test.assertEqual(got.textCount(), 0, "binary never delivered as text")
    test.assertEqual(got.bin(0).length(), 256, "256 bytes back")
    test.assert(got.bin(0).equals(all), "every byte value 0..255 intact")
    // A buffer filled with write*() calls has its cursor at the end; it must
    // still go out whole, and sending it twice must send it twice.
    var written: Buffer = Buffer.alloc(8)
    written.writeUInt32BE(3735928559)
    written.writeUInt32BE(305419896)
    client.sendBinary(written)
    client.sendBinary(written)
    test.assert(waitFor(function(): bool { return got.binCount() == 3 }, 3000), "both sends echoed")
    test.assertEqual(got.bin(1).toString("hex"), "deadbeef12345678", "write*-filled buffer sent whole")
    test.assertEqual(got.bin(2).toString("hex"), "deadbeef12345678", "second send identical")
    client.close(CLOSE_NORMAL, "done")
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("binary all bytes: " + string(e))
}

// ─── 7. Binary sizes at the 7/16/64-bit length boundaries ───────────────────
try {
    var port: int = freePort()
    var server: WebSocketServer = echoServer(port, 1048576)
    var got: BinCollector = new BinCollector()
    var client: WebSocketClient = recordingClient(port, got)
    var sizes: []int = [0, 1, 125, 126, 127, 65535, 65536, 200000]
    for (var i: int = 0; i < sizes.length; i++) { client.sendBinary(pattern(sizes[i], i)) }
    test.assert(waitFor(function(): bool { return got.binCount() == sizes.length }, 5000), "all sizes echoed")
    for (var i: int = 0; i < sizes.length; i++) {
        test.assertEqual(got.bin(i).length(), sizes[i], "size " + string(sizes[i]))
        test.assert(got.bin(i).equals(pattern(sizes[i], i)), "bytes intact at size " + string(sizes[i]))
    }
    client.close(CLOSE_NORMAL, "done")
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("binary length boundaries: " + string(e))
}

// ─── 8. Fragmented binary (with a ping between fragments) from a raw peer ───
// The server must reassemble it as one binary message and answer with one
// unmasked binary frame; a fragmented text message stays text.
try {
    var port: int = freePort()
    var server: WebSocketServer = echoServer(port, 1048576)
    var tcp: TcpConnection = rawClient(port)
    var whole: Buffer = pattern(300, 3)
    tcp.writeAll(rawFrame(false, 2, whole.slice(0, 100)))
    tcp.writeAll(rawFrame(false, 0, whole.slice(100, 200)))
    tcp.writeAll(rawFrame(true, 9, Buffer.fromString("hi")))
    tcp.writeAll(rawFrame(true, 0, whole.slice(200, 300)))
    var pong: RawFrame = readRawFrame(tcp)
    test.assertEqual(pong.opcode, 10, "ping answered between fragments")
    var echo: RawFrame = readRawFrame(tcp)
    test.assertEqual(echo.opcode, 2, "echo is a binary frame")
    test.assert(echo.fin, "echo is one frame")
    test.assert(!echo.masked, "server frames are unmasked")
    test.assert(echo.payload.equals(whole), "fragmented binary reassembled intact")
    tcp.writeAll(rawFrame(false, 1, Buffer.fromString("hé")))
    tcp.writeAll(rawFrame(true, 0, Buffer.fromString("llo")))
    var techo: RawFrame = readRawFrame(tcp)
    test.assertEqual(techo.opcode, 1, "fragmented text echoes as text")
    test.assertEqual(techo.payload.toStringUtf8(), "héllo", "fragmented text intact")
    tcp.close()
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("fragmented binary: " + string(e))
}

// ─── 9. Mixed text and binary on one connection keep their order ────────────
try {
    var port: int = freePort()
    var server: WebSocketServer = echoServer(port, 1048576)
    var got: BinCollector = new BinCollector()
    var client: WebSocketClient = recordingClient(port, got)
    var want: []string = []
    for (var i: int = 0; i < 20; i++) {
        if (i % 2 == 0) {
            client.send("m" + string(i))
            want.push("t:m" + string(i))
        } else {
            client.sendBinary(pattern(i * 10, i))
            want.push("b:" + string(i * 10))
        }
    }
    test.assert(waitFor(function(): bool { return got.binCount() + got.textCount() == 20 }, 3000), "all 20 echoed")
    test.assertEqual(got.orderLog(), strings.join(want, ","), "order and kind preserved")
    client.close(CLOSE_NORMAL, "done")
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("mixed text and binary: " + string(e))
}

// ─── 10. maxMessageSize applies to binary and to the whole fragmented message ─
try {
    var port: int = freePort()
    var server: WebSocketServer = echoServer(port, 1000)
    var got: BinCollector = new BinCollector()
    var client: WebSocketClient = recordingClient(port, got)
    client.sendBinary(pattern(1000, 1))
    test.assert(waitFor(function(): bool { return got.binCount() == 1 }, 3000), "a message at the limit passes")
    client.sendBinary(pattern(1001, 1))
    test.assert(waitFor(function(): bool { return got.code() != 0 }, 3000), "an over-limit message closes the connection")
    test.assertEqual(got.code(), CLOSE_TOO_LARGE, "closed with 1009")

    var tcp: TcpConnection = rawClient(port)
    tcp.writeAll(rawFrame(false, 2, pattern(600, 0)))
    tcp.writeAll(rawFrame(true, 0, pattern(600, 0)))
    var cl: RawFrame = readRawFrame(tcp)
    test.assertEqual(cl.opcode, 8, "fragments over the limit get a close frame")
    cl.payload.seek(0)
    test.assertEqual(cl.payload.readUInt16BE(), CLOSE_TOO_LARGE, "fragment total over the limit closes with 1009")
    tcp.close()
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("binary maxMessageSize: " + string(e))
}

// ─── 11. Text is unchanged; binary without onBinary falls back to onMessage ──
try {
    var port: int = freePort()
    var server: WebSocketServer = echoServer(port, 1048576)
    var got: BinCollector = new BinCollector()
    var client: WebSocketClient = recordingClient(port, got)
    client.send("héllo ✓ wörld")
    test.assert(waitFor(function(): bool { return got.textCount() == 1 }, 3000), "text echoed")
    test.assertEqual(got.text(0), "héllo ✓ wörld", "UTF-8 text intact")
    test.assertEqual(got.binCount(), 0, "text never delivered as binary")
    client.close(CLOSE_NORMAL, "done")

    var legacy: Collector = new Collector()
    var old = connect("ws://127.0.0.1:" + string(port), null)
    old.onMessage(function(msg: string): void { legacy.add(msg) })
    old.sendBinary(Buffer.fromString("abc"))
    test.assert(waitFor(function(): bool { return legacy.count() == 1 }, 3000), "binary reaches onMessage when no onBinary is set")
    test.assertEqual(legacy.first(), "abc", "1.1 fallback delivers the bytes as a string")
    old.close(CLOSE_NORMAL, "done")
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("text unchanged: " + string(e))
}

// ─── 12. Large binary broadcast and room broadcast ──────────────────────────
try {
    var port: int = freePort()
    var server: WebSocketServer = createWSServer(new WSServerOptionsBuilder().host("127.0.0.1").port(port).build())
    server.onConnection(function(conn: WebSocketConnection): void {
        conn.onMessage(function(msg: string): void { conn.join(msg) })
    })
    spawn server.listen()
    time.sleep(200)
    var cols: []BinCollector = []
    var clients: []WebSocketClient = []
    for (var i: int = 0; i < 8; i++) {
        var col: BinCollector = new BinCollector()
        cols.push(col)
        var c: WebSocketClient = recordingClient(port, col)
        clients.push(c)
        if (i < 3) { c.send("red") }
    }
    test.assert(waitFor(function(): bool { return server.connectionCount() == 8 }, 3000), "8 clients connected")
    time.sleep(100)
    var big: Buffer = pattern(500000, 9)
    server.broadcastBinary(big)
    var small: Buffer = pattern(50, 4)
    server.broadcastBinaryToRoom("red", small)
    test.assert(waitFor(function(): bool {
        for (var i: int = 0; i < 8; i++) {
            var want: int = 1
            if (i < 3) { want = 2 }
            if (cols[i].binCount() != want) { return false }
        }
        return true
    }, 5000), "broadcast and room broadcast arrived")
    for (var i: int = 0; i < 8; i++) {
        test.assert(cols[i].bin(0).equals(big), "client " + string(i) + " got the 500 KB broadcast intact")
        if (i < 3) { test.assert(cols[i].bin(1).equals(small), "room member got the room broadcast") }
    }
    for (var i: int = 0; i < 8; i++) { clients[i].close(CLOSE_NORMAL, "done") }
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("binary broadcast: " + string(e))
}

// ─── 13. The client masks its binary frames (raw server reads them) ─────────
try {
    var port: int = freePort()
    var raw: TcpServer = new TcpServer("127.0.0.1", port)
    var seen: BinCollector = new BinCollector()
    async function serveRaw(): Task<void> {
        var tcp: TcpConnection = raw.accept()
        var head: string = readHead(tcp)
        var keyAt: int = strings.indexOf(head, "Sec-WebSocket-Key: ") + 19
        var rest: string = strings.substring(head, keyAt, head.length)
        var key: string = strings.substring(rest, 0, strings.indexOf(rest, "\r\n"))
        tcp.writeAll(Buffer.fromString("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + computeAcceptKey(key) + "\r\n\r\n"))
        var f: RawFrame = readRawFrame(tcp)
        seen.addText("op" + string(f.opcode) + (f.masked ? ":masked" : ":plain"))
        seen.addBin(f.payload)
        tcp.close()
    }
    spawn serveRaw()
    var client = connect("ws://127.0.0.1:" + string(port), null)
    var data: Buffer = pattern(70000, 2)
    client.sendBinary(data)
    test.assert(waitFor(function(): bool { return seen.binCount() == 1 }, 3000), "raw server read the frame")
    test.assertEqual(seen.text(0), "op2:masked", "client binary frame is masked, opcode 2")
    test.assert(seen.bin(0).equals(data), "unmasked payload intact")
    raw.close()
    passed++
} catch (e) {
    failed++
    failures.push("client masking: " + string(e))
}

// ─── 14. Subprotocol negotiation ────────────────────────────────────────────
try {
    var port: int = freePort()
    var server: WebSocketServer = createWSServer(new WSServerOptionsBuilder().host("127.0.0.1").port(port).build()).protocols(["v2", "v1"])
    var seen: BinCollector = new BinCollector()
    server.onConnection(function(conn: WebSocketConnection): void { seen.addText(conn.protocol()) })
    spawn server.listen()
    time.sleep(200)
    var c1: WebSocketClient = createWSClient("ws://127.0.0.1:" + string(port), null).protocols(["v1", "v2"])
    c1.connect()
    test.assertEqual(c1.protocol(), "v1", "the first protocol the client offered that the server speaks")
    var c2: WebSocketClient = createWSClient("ws://127.0.0.1:" + string(port), null).protocols(["v9"])
    c2.connect()
    test.assertEqual(c2.protocol(), "", "no common protocol: none chosen, still connected")
    var c3 = connect("ws://127.0.0.1:" + string(port), null)
    test.assertEqual(c3.protocol(), "", "no protocol offered")
    test.assert(waitFor(function(): bool { return seen.textCount() == 3 }, 2000), "server saw three connections")
    test.assertEqual(seen.text(0), "v1", "connection exposes the chosen protocol")
    c1.close(CLOSE_NORMAL, ""); c2.close(CLOSE_NORMAL, ""); c3.close(CLOSE_NORMAL, "")
    server.stop()

    var port2: int = freePort()
    var strict: WebSocketServer = createWSServer(new WSServerOptionsBuilder().host("127.0.0.1").port(port2).build())
        .selectProtocol(function(offered: []string): string {
            for (var i: int = 0; i < offered.length; i++) { if (offered[i] == "chat.v3") { return "chat.v3" } }
            return ""
        })
        .requireProtocol(true)
    spawn strict.listen()
    time.sleep(200)
    var c4: WebSocketClient = createWSClient("ws://127.0.0.1:" + string(port2), null).protocols(["chat.v2", "chat.v3"])
    c4.connect()
    test.assertEqual(c4.protocol(), "chat.v3", "selector callback chose")
    var refused: string = ""
    try {
        createWSClient("ws://127.0.0.1:" + string(port2), null).protocols(["chat.v2"]).connect()
    } catch (e) { refused = string(e) }
    test.assert(strings.contains(refused, "400"), "required protocol missing: refused with 400")
    c4.close(CLOSE_NORMAL, "")
    strict.stop()
    passed++
} catch (e) {
    failed++
    failures.push("subprotocols: " + string(e))
}

// ─── 15. Origin check (403 before the upgrade) ──────────────────────────────
try {
    var port: int = freePort()
    var server: WebSocketServer = createWSServer(new WSServerOptionsBuilder().host("127.0.0.1").port(port).build()).allowOrigins(["https://good.example"])
    spawn server.listen()
    time.sleep(200)
    var good: WebSocketClient = createWSClient("ws://127.0.0.1:" + string(port), null).origin("https://good.example")
    good.connect()
    test.assert(good.isOpen(), "allowed origin connects")
    var bad: string = ""
    try { createWSClient("ws://127.0.0.1:" + string(port), null).origin("https://evil.example").connect() } catch (e) { bad = string(e) }
    test.assert(strings.contains(bad, "403"), "other origin refused with 403")
    var none = connect("ws://127.0.0.1:" + string(port), null)
    test.assert(none.isOpen(), "no Origin header (non-browser client) connects")
    good.close(CLOSE_NORMAL, ""); none.close(CLOSE_NORMAL, "")
    server.stop()

    var port2: int = freePort()
    var cb: WebSocketServer = createWSServer(new WSServerOptionsBuilder().host("127.0.0.1").port(port2).build())
        .checkOrigin(function(origin: string): bool { return strings.endsWith(origin, ".example.com") })
    spawn cb.listen()
    time.sleep(200)
    var ok: WebSocketClient = createWSClient("ws://127.0.0.1:" + string(port2), null).origin("https://app.example.com")
    ok.connect()
    test.assert(ok.isOpen(), "callback allowed the origin")
    var noOrigin: string = ""
    try { connect("ws://127.0.0.1:" + string(port2), null) } catch (e) { noOrigin = string(e) }
    test.assert(strings.contains(noOrigin, "403"), "callback refused an empty origin")
    ok.close(CLOSE_NORMAL, "")
    cb.stop()
    passed++
} catch (e) {
    failed++
    failures.push("origin check: " + string(e))
}

// ─── 16. Backpressure: bufferedAmount, drain, and a peer that never reads ───
try {
    var port: int = freePort()
    var server: WebSocketServer = createWSServer(new WSServerOptionsBuilder().host("127.0.0.1").port(port).build())
        .highWaterMark(65536)
        .maxBufferedBytes(4194304)
    var events: BinCollector = new BinCollector()
    server.onConnection(function(conn: WebSocketConnection): void {
        conn.onDrain(function(): void { events.addText("drain:" + string(conn.bufferedAmount())) })
        conn.onClose(function(code: int, reason: string): void { events.addText("close:" + string(code) + ":" + reason) })
        conn.onMessage(function(msg: string): void {
            if (msg == "big") {
                var below: bool = conn.sendBinary(pattern(300000, 1))
                events.addText("below:" + string(below))
            } else if (msg == "flood") {
                var big: Buffer = pattern(262144, 2)
                for (var i: int = 0; i < 400 && conn.isOpen(); i++) { conn.sendBinary(big) }
                events.addText("flood done")
            }
        })
    })
    spawn server.listen()
    time.sleep(200)

    // A reading client: send() reports the high-water mark, onDrain follows.
    var got: BinCollector = new BinCollector()
    var reader: WebSocketClient = recordingClient(port, got)
    reader.send("big")
    test.assert(waitFor(function(): bool { return got.binCount() == 1 }, 3000), "big message delivered")
    test.assert(waitFor(function(): bool { return strings.contains(events.orderLog(), "drain:0") }, 3000), "onDrain fired with an empty queue")
    test.assert(strings.contains(events.orderLog(), "t:below:false"), "send returned false above the high-water mark")

    // A peer that never reads: its queue passes maxBufferedBytes and it is
    // closed with 1008, while the sender never blocks and other clients go on.
    var tcp: TcpConnection = rawClient(port)
    tcp.writeAll(rawFrame(true, 1, Buffer.fromString("flood")))
    test.assert(waitFor(function(): bool { return strings.contains(events.orderLog(), "flood done") }, 10000), "the flooding sender never blocked")
    test.assert(waitFor(function(): bool { return strings.contains(events.orderLog(), "close:1008:send buffer overflow") }, 10000), "a never-draining peer is closed with 1008")
    reader.send("big")
    test.assert(waitFor(function(): bool { return got.binCount() == 2 }, 3000), "other connections unaffected")
    tcp.close()
    reader.close(CLOSE_NORMAL, "")
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("backpressure: " + string(e))
}

// ─── 17. wss:// served directly (TLS listener) ──────────────────────────────
try {
    var port: int = freePort()
    var certs: any = tlsSelfSigned(["localhost", "127.0.0.1"])
    var server: WebSocketServer = createWSServer(new WSServerOptionsBuilder().host("127.0.0.1").port(port).build())
        .tls({ "cert": certs["cert"], "key": certs["key"] })
    server.onConnection(function(conn: WebSocketConnection): void {
        conn.onMessage(function(msg: string): void { conn.send("tls:" + msg) })
        conn.onBinary(function(data: Buffer): void { conn.sendBinary(data) })
    })
    spawn server.listen()
    time.sleep(300)
    var got: BinCollector = new BinCollector()
    var client: WebSocketClient = createWSClient("wss://localhost:" + string(port), null).tls({ "ca": certs["ca"] })
    client.onMessage(function(msg: string): void { got.addText(msg) })
    client.onBinary(function(data: Buffer): void { got.addBin(data) })
    client.connect()
    client.send("hello")
    client.sendBinary(pattern(70000, 5))
    test.assert(waitFor(function(): bool { return got.textCount() == 1 && got.binCount() == 1 }, 5000), "echoes over TLS")
    test.assertEqual(got.text(0), "tls:hello", "text over wss")
    test.assert(got.bin(0).equals(pattern(70000, 5)), "binary over wss")
    client.close(CLOSE_NORMAL, "")
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("wss server: " + string(e))
}

// ─── 18. Close codes and reasons; UTF-8 checks ──────────────────────────────
try {
    var port: int = freePort()
    var server: WebSocketServer = echoServer(port, 1048576)
    var closes: BinCollector = new BinCollector()
    server.onDisconnect(function(conn: WebSocketConnection): void { closes.addText(string(conn.closeCode()) + ":" + conn.closeReason()) })

    // A valid code and reason are echoed and exposed.
    var got: BinCollector = new BinCollector()
    var c: WebSocketClient = recordingClient(port, got)
    c.close(4001, "game over")
    test.assert(waitFor(function(): bool { return got.code() != 0 }, 3000), "close handshake completed")
    test.assertEqual(got.code(), 4001, "server answered with the client's code")
    test.assertEqual(c.closeCode(), 4001, "client exposes the close code")
    test.assert(waitFor(function(): bool { return closes.textCount() == 1 }, 3000), "server saw the close")
    test.assertEqual(closes.text(0), "4001:game over", "server exposes code and reason")

    // Codes that may not be sent are refused locally.
    var thrown: bool = false
    var c2 = connect("ws://127.0.0.1:" + string(port), null)
    try { c2.close(1006, "x") } catch (e) { thrown = true }
    test.assert(thrown, "close(1006) throws: 1006 is never sent on the wire")
    c2.close(CLOSE_NORMAL, "")

    // A received invalid close code fails the connection with 1002.
    var t1: TcpConnection = rawClient(port)
    var badClose: Buffer = Buffer.alloc(2)
    badClose.writeUInt16BE(1005)
    t1.writeAll(rawFrame(true, 8, badClose))
    test.assertEqual(closeCodeOf(readRawFrame(t1)), CLOSE_PROTOCOL_ERROR, "close code 1005 on the wire: 1002")
    t1.close()

    // Invalid UTF-8 text, whole or split over frames: 1007.
    var t2: TcpConnection = rawClient(port)
    t2.writeAll(rawFrame(true, 1, Buffer.fromHex("cebae1bdb9cf83cebcceb5eda080")))
    test.assertEqual(closeCodeOf(readRawFrame(t2)), CLOSE_INVALID_PAYLOAD, "invalid UTF-8 text: 1007")
    t2.close()
    var t3: TcpConnection = rawClient(port)
    t3.writeAll(rawFrame(false, 1, Buffer.fromHex("e282")))
    t3.writeAll(rawFrame(true, 0, Buffer.fromHex("ac")))
    var euro: RawFrame = readRawFrame(t3)
    test.assertEqual(euro.payload.toStringUtf8(), "€", "a character split across frames is valid")
    t3.writeAll(rawFrame(false, 1, Buffer.fromHex("e282")))
    t3.writeAll(rawFrame(true, 0, Buffer.fromHex("28")))
    test.assertEqual(closeCodeOf(readRawFrame(t3)), CLOSE_INVALID_PAYLOAD, "invalid continuation byte across frames: 1007")
    t3.close()

    // Protocol errors: reserved bits, unmasked client frame, fragmented ping.
    var t4: TcpConnection = rawClient(port)
    var rsv: Buffer = rawFrame(true, 1, Buffer.fromString("x"))
    rsv.setByte(0, rsv.getByte(0) + 64)
    t4.writeAll(rsv)
    test.assertEqual(closeCodeOf(readRawFrame(t4)), CLOSE_PROTOCOL_ERROR, "RSV1 without an extension: 1002")
    t4.close()
    var t5: TcpConnection = rawClient(port)
    t5.writeAll(Buffer.fromHex("810178"))
    test.assertEqual(closeCodeOf(readRawFrame(t5)), CLOSE_PROTOCOL_ERROR, "unmasked client frame: 1002")
    t5.close()
    var t6: TcpConnection = rawClient(port)
    t6.writeAll(rawFrame(false, 9, Buffer.fromString("p")))
    test.assertEqual(closeCodeOf(readRawFrame(t6)), CLOSE_PROTOCOL_ERROR, "fragmented ping: 1002")
    t6.close()

    test.assert(isValidUtf8(Buffer.fromString("héllo ✓")), "isValidUtf8 accepts UTF-8")
    test.assert(!isValidUtf8(Buffer.fromHex("eda080")), "isValidUtf8 rejects a surrogate")
    test.assert(isValidUtf8(Buffer.fromHex("efbfbd41")), "isValidUtf8 accepts a real U+FFFD")
    test.assert(!isValidUtf8(Buffer.fromHex("c0af")), "isValidUtf8 rejects an overlong form")
    test.assert(!isValidUtf8(Buffer.fromHex("f4908080")), "isValidUtf8 rejects a code point past U+10FFFF")
    test.assert(!isValidUtf8(Buffer.fromHex("41e282")), "isValidUtf8 rejects a cut character")
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("close codes and UTF-8: " + string(e))
}

// ─── 19. Handshake checks (RFC 6455 §4.2.1) ─────────────────────────────────
try {
    var port: int = freePort()
    var server: WebSocketServer = echoServer(port, 1048576)
    var key: string = "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"
    var ok: string = rawHandshake(port, upgradeRequest(key + "Sec-WebSocket-Version: 13\r\n"))
    test.assert(strings.startsWith(ok, "HTTP/1.1 101"), "a valid request upgrades")
    test.assert(strings.contains(ok, "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="), "accept key in the response")
    var v8: string = rawHandshake(port, upgradeRequest(key + "Sec-WebSocket-Version: 8\r\n"))
    test.assert(strings.startsWith(v8, "HTTP/1.1 426") && strings.contains(v8, "Sec-WebSocket-Version: 13"), "other versions: 426 naming version 13")
    var badKey: string = rawHandshake(port, upgradeRequest("Sec-WebSocket-Key: c2hvcnQ=\r\nSec-WebSocket-Version: 13\r\n"))
    test.assert(strings.startsWith(badKey, "HTTP/1.1 400"), "a key that is not 16 bytes: 400")
    var post: string = rawHandshake(port, "POST / HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n" + key + "Sec-WebSocket-Version: 13\r\n\r\n")
    test.assert(strings.startsWith(post, "HTTP/1.1 400"), "POST: 400")
    var noHost: string = rawHandshake(port, "GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n" + key + "Sec-WebSocket-Version: 13\r\n\r\n")
    test.assert(strings.startsWith(noHost, "HTTP/1.1 400"), "no Host: 400")
    var mixed: string = rawHandshake(port, "GET / HTTP/1.1\r\nhost: x\r\nupgrade: WebSocket\r\nconnection: keep-alive, Upgrade\r\nsec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\nsec-websocket-version: 13\r\n\r\n")
    test.assert(strings.startsWith(mixed, "HTTP/1.1 101"), "header names and tokens are case-insensitive; Connection is a list")
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("handshake checks: " + string(e))
}

// ─── 20. permessage-deflate round trips, with context takeover ──────────────
try {
    var port: int = freePort()
    var server: WebSocketServer = deflateServer(port, 1048576, new WSDeflateOptionsBuilder().threshold(0).build())
    var exts: BinCollector = new BinCollector()
    server.onConnection(function(conn: WebSocketConnection): void {
        exts.addText(conn.extensions())
        conn.onMessage(function(msg: string): void { conn.send(msg) })
        conn.onBinary(function(data: Buffer): void { conn.sendBinary(data) })
    })
    var got: BinCollector = new BinCollector()
    var c: WebSocketClient = createWSClient("ws://127.0.0.1:" + string(port), null).perMessageDeflate(new WSDeflateOptionsBuilder().threshold(0).build())
    c.onMessage(function(m: string): void { got.addText(m) })
    c.onBinary(function(b: Buffer): void { got.addBin(b) })
    c.connect()
    test.assert(strings.startsWith(c.extensions(), "permessage-deflate"), "client agreed permessage-deflate")
    var snap: string = snapshotText(50, 1)
    for (var i: int = 0; i < 5; i++) { c.send(snap) }
    c.send("")
    c.send("héllo ✓")
    c.sendBinary(pattern(100000, 3))
    test.assert(waitFor(function(): bool { return got.textCount() == 7 && got.binCount() == 1 }, 5000), "all echoed")
    for (var i: int = 0; i < 5; i++) { test.assertEqual(got.text(i), snap, "snapshot " + string(i) + " intact") }
    test.assertEqual(got.text(5), "", "empty message intact")
    test.assertEqual(got.text(6), "héllo ✓", "UTF-8 intact")
    test.assert(got.bin(0).equals(pattern(100000, 3)), "binary intact")
    test.assert(strings.startsWith(exts.text(0), "permessage-deflate"), "server connection exposes the extension")
    c.close(CLOSE_NORMAL, "")

    // On the wire: the echo of a compressed message is compressed (RSV1) and
    // inflates to the message.
    var head: Box = new Box()
    var tcp: TcpConnection = rawClientExt(port, "permessage-deflate; client_max_window_bits", head)
    test.assert(strings.contains(head.get(), "Sec-WebSocket-Extensions: permessage-deflate"), "server accepted the raw offer")
    var payload: Buffer = Buffer.fromString(snap)
    var f1: Buffer = rawFrame(true, 1, deflateMessage(payload))
    f1.setByte(0, f1.getByte(0) + 64)
    tcp.writeAll(f1)
    var echo: RawFrame = readRawFrame(tcp)
    test.assert(echo.rsv1, "echo is compressed")
    test.assert(echo.payload.length() < payload.length() / 3, "and much smaller")
    test.assert(inflateMessage(echo.payload).equals(payload), "inflates to the message")
    tcp.close()
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("deflate round trip: " + string(e))
}

// ─── 21. Every window size, with and without context takeover ───────────────
try {
    for (var bits: int = 8; bits <= 15; bits++) {
        var noCtx: bool = bits % 2 == 0
        var port: int = freePort()
        var opts: WSDeflateOptions = new WSDeflateOptionsBuilder().threshold(0).serverMaxWindowBits(bits).clientMaxWindowBits(bits)
            .serverNoContextTakeover(noCtx).clientNoContextTakeover(noCtx).build()
        var server: WebSocketServer = deflateServer(port, 1048576, opts)
        var got: BinCollector = new BinCollector()
        var c: WebSocketClient = createWSClient("ws://127.0.0.1:" + string(port), null).perMessageDeflate(opts)
        c.onMessage(function(m: string): void { got.addText(m) })
        c.onBinary(function(b: Buffer): void { got.addBin(b) })
        c.connect()
        var ext: string = c.extensions()
        // 15 is the default, so neither side names it.
        test.assert(bits == 15 || strings.contains(ext, "server_max_window_bits=" + string(bits)), "window " + string(bits) + " agreed: " + ext)
        test.assert(strings.contains(ext, "client_max_window_bits=" + string(bits)), "client window " + string(bits) + " agreed: " + ext)
        test.assertEqual(strings.contains(ext, "client_no_context_takeover"), noCtx, "context takeover as asked at " + string(bits))
        var snap: string = snapshotText(60, bits)
        for (var i: int = 0; i < 3; i++) { c.send(snap) }
        c.sendBinary(pattern(40000, bits))
        test.assert(waitFor(function(): bool { return got.textCount() == 3 && got.binCount() == 1 }, 5000), "echoes at window " + string(bits))
        for (var i: int = 0; i < 3; i++) { test.assertEqual(got.text(i), snap, "text intact at window " + string(bits)) }
        test.assert(got.bin(0).equals(pattern(40000, bits)), "binary intact at window " + string(bits))
        c.close(CLOSE_NORMAL, "")
        server.stop()
    }
    passed++
} catch (e) {
    failed++
    failures.push("deflate window sizes: " + string(e))
}

// ─── 22. Fragmented compressed message; RSV1 rules ──────────────────────────
try {
    var port: int = freePort()
    var server: WebSocketServer = deflateServer(port, 1048576, new WSDeflateOptionsBuilder().threshold(0).build())
    var head: Box = new Box()
    var tcp: TcpConnection = rawClientExt(port, "permessage-deflate", head)
    var payload: Buffer = pattern(30000, 7)
    var z: Buffer = deflateMessage(payload)
    var third: int = z.length() / 3
    var a: Buffer = rawFrame(false, 2, z.slice(0, third))
    a.setByte(0, a.getByte(0) + 64)
    tcp.writeAll(a)
    tcp.writeAll(rawFrame(false, 0, z.slice(third, 2 * third)))
    tcp.writeAll(rawFrame(true, 0, z.slice(2 * third, z.length())))
    var echo: RawFrame = readRawFrame(tcp)
    test.assertEqual(echo.opcode, 2, "binary echo")
    test.assert(inflateMessage(echo.payload).equals(payload), "fragmented compressed message reassembled")
    // RSV1 on a continuation frame is a protocol error.
    var b: Buffer = rawFrame(false, 1, deflateMessage(Buffer.fromString("abc")))
    b.setByte(0, b.getByte(0) + 64)
    tcp.writeAll(b)
    var c2: Buffer = rawFrame(true, 0, Buffer.fromString("x"))
    c2.setByte(0, c2.getByte(0) + 64)
    tcp.writeAll(c2)
    test.assertEqual(closeCodeOf(readRawFrame(tcp)), CLOSE_PROTOCOL_ERROR, "RSV1 on a continuation: 1002")
    tcp.close()
    // RSV1 on a control frame is a protocol error.
    var t2: TcpConnection = rawClientExt(port, "permessage-deflate", head)
    var p: Buffer = rawFrame(true, 9, Buffer.fromString("p"))
    p.setByte(0, p.getByte(0) + 64)
    t2.writeAll(p)
    test.assertEqual(closeCodeOf(readRawFrame(t2)), CLOSE_PROTOCOL_ERROR, "RSV1 on a ping: 1002")
    t2.close()
    // Corrupt compressed data: 1007.
    var t3: TcpConnection = rawClientExt(port, "permessage-deflate", head)
    var bad: Buffer = rawFrame(true, 2, Buffer.fromHex("ffffffffff"))
    bad.setByte(0, bad.getByte(0) + 64)
    t3.writeAll(bad)
    test.assertEqual(closeCodeOf(readRawFrame(t3)), CLOSE_INVALID_PAYLOAD, "corrupt compressed data: 1007")
    t3.close()
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("deflate fragments: " + string(e))
}

// ─── 23. Peers without compression; the threshold ───────────────────────────
try {
    var port: int = freePort()
    var server: WebSocketServer = deflateServer(port, 1048576, new WSDeflateOptionsBuilder().threshold(100).build())
    // A client that does not offer it.
    var got: BinCollector = new BinCollector()
    var plain: WebSocketClient = recordingClient(port, got)
    test.assertEqual(plain.extensions(), "", "no extension without an offer")
    plain.send(snapshotText(20, 0))
    test.assert(waitFor(function(): bool { return got.textCount() == 1 }, 3000), "uncompressed echo")
    plain.close(CLOSE_NORMAL, "")
    // A server without compression and a client that offers it.
    var port2: int = freePort()
    var plainServer: WebSocketServer = echoServer(port2, 1048576)
    var got2: BinCollector = new BinCollector()
    var offering: WebSocketClient = createWSClient("ws://127.0.0.1:" + string(port2), null).perMessageDeflate(new WSDeflateOptionsBuilder().build())
    offering.onMessage(function(m: string): void { got2.addText(m) })
    offering.connect()
    test.assertEqual(offering.extensions(), "", "server declined by not answering")
    offering.send(snapshotText(20, 0))
    test.assert(waitFor(function(): bool { return got2.textCount() == 1 }, 3000), "works uncompressed")
    offering.close(CLOSE_NORMAL, "")
    plainServer.stop()
    // The threshold: under 100 bytes plain, at or over compressed, mixed in order.
    var head: Box = new Box()
    var tcp: TcpConnection = rawClientExt(port, "permessage-deflate", head)
    tcp.writeAll(rawFrame(true, 1, Buffer.fromString("short")))
    var s1: RawFrame = readRawFrame(tcp)
    test.assert(!s1.rsv1, "a message under the threshold goes uncompressed")
    test.assertEqual(s1.payload.toStringUtf8(), "short", "and intact")
    var big: string = snapshotText(10, 0)
    var bf: Buffer = rawFrame(true, 1, deflateMessage(Buffer.fromString(big)))
    bf.setByte(0, bf.getByte(0) + 64)
    tcp.writeAll(bf)
    tcp.writeAll(rawFrame(true, 1, Buffer.fromString("after")))
    var s2: RawFrame = readRawFrame(tcp)
    test.assert(s2.rsv1, "a message over the threshold is compressed")
    test.assertEqual(inflateMessage(s2.payload).toStringUtf8(), big, "and inflates to it")
    var s3: RawFrame = readRawFrame(tcp)
    test.assertEqual(s3.payload.toStringUtf8(), "after", "order kept across compressed and plain")
    tcp.close()
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("deflate fallback and threshold: " + string(e))
}

// ─── 24. maxMessageSize applies to the decompressed size ────────────────────
try {
    var port: int = freePort()
    var server: WebSocketServer = deflateServer(port, 10000, new WSDeflateOptionsBuilder().threshold(0).build())
    var head: Box = new Box()
    var tcp: TcpConnection = rawClientExt(port, "permessage-deflate", head)
    var fits: Buffer = Buffer.alloc(10000)
    var f1: Buffer = rawFrame(true, 2, deflateMessage(fits))
    f1.setByte(0, f1.getByte(0) + 64)
    tcp.writeAll(f1)
    var e1: RawFrame = readRawFrame(tcp)
    test.assertEqual(inflateMessage(e1.payload).length(), 10000, "10,000 bytes inflated: at the limit, accepted")
    // A million zeros compress to about a kilobyte: a bomb for a 10,000 limit.
    var bomb: Buffer = deflateMessage(Buffer.alloc(1000000))
    test.assert(bomb.length() < 2000, "the bomb is small on the wire")
    var f2: Buffer = rawFrame(true, 2, bomb)
    f2.setByte(0, f2.getByte(0) + 64)
    tcp.writeAll(f2)
    test.assertEqual(closeCodeOf(readRawFrame(tcp)), CLOSE_TOO_LARGE, "inflating past maxMessageSize: 1009")
    tcp.close()
    // The same over fragments.
    var t2: TcpConnection = rawClientExt(port, "permessage-deflate", head)
    var z: Buffer = deflateMessage(Buffer.alloc(30000))
    var a: Buffer = rawFrame(false, 2, z.slice(0, z.length() / 2))
    a.setByte(0, a.getByte(0) + 64)
    t2.writeAll(a)
    t2.writeAll(rawFrame(true, 0, z.slice(z.length() / 2, z.length())))
    test.assertEqual(closeCodeOf(readRawFrame(t2)), CLOSE_TOO_LARGE, "fragmented bomb: 1009")
    t2.close()
    server.stop()
    passed++
} catch (e) {
    failed++
    failures.push("deflate size limit: " + string(e))
}

test.report(passed, failed, failures, test.now() - start)
